{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://sankalp-ai-sr0e.onrender.com/api/:path*"
        },
        {
            "source": "/uploads/:path*",
            "destination": "https://sankalp-ai-sr0e.onrender.com/uploads/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}