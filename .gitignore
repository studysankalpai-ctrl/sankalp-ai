# Root .gitignore for SANKALP

# Environment files
.env
.env.local
.env.*.local
.env.*
!.env.example
*.env

# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Production build outputs
dist/
dist-ssr/
frontend/dist/

# Uploaded runtime user files
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
